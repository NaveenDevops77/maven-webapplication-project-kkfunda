pipeline {
    agent any

    tools {
        maven "maven-3.9.0"
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'dev',
                url: 'https://github.com/NaveenDevops77/maven-webapplication-project-kkfunda.git'
            }
        }

        stage('Compile') {
            steps {
                sh "mvn clean compile"
            }
        }

        stage('Build') {
            steps {
                sh "mvn clean package"
            }
        }

        stage('Generate Report') {
            steps {
                sh "mvn sonar:sonar"
            }
        }

        stage('Move to Nexus') {
            steps {
                sh "mvn deploy"
            }
        }

       stage('Deploy to Tomcat') {
    steps {

        withCredentials([
            usernamePassword(
                credentialsId: 'tomcatcred',
                usernameVariable: 'TOMCAT_USER',
                passwordVariable: 'TOMCAT_PASS'
            )
        ]) {

            sh '''
            curl -u $TOMCAT_USER:$TOMCAT_PASS \
            --upload-file target/maven-web-application.war \
            "http://3.110.181.253:8080/manager/text/deploy?path=/maven-web-application&update=true"
            '''
        }
    }
}
    }

    post {

        success {
            echo "Pipeline SUCCESS"

            slackSend channel: '#prod',
                color: 'good',
                message: "✅ SUCCESS: Job '${env.JOB_NAME} [${env.BUILD_NUMBER}]' completed successfully. 🎉"
        }

        failure {
            echo "Pipeline FAILED"

            slackSend channel: '#prod',
                color: 'danger',
                message: "❌ FAILED: Job '${env.JOB_NAME} [${env.BUILD_NUMBER}]' failed. Check Jenkins console."
        }

        always {
            echo "Pipeline finished"

            slackSend channel: '#prod',
                color: '#439FE0',
                message: "ℹ️ Job '${env.JOB_NAME} [${env.BUILD_NUMBER}]' finished with status: ${currentBuild.currentResult}"
        }
    }
}
