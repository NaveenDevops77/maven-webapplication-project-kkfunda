@Library('mylib')_
pipeline
{
    agent any
    tools
    {
      maven "maven-3.9.0"
    }
    stages
    {
        stage ('checkout')
        {
            steps
            {
                git branch: 'dev', url: 'https://github.com/NaveenDevops77/maven-webapplication-project-kkfunda.git'
            }
        }
        stage ('compile')
        {
            steps
            {
                sh "mvn clean compile"
            }
        } 
        stage ('build')
        {
            steps
            {
                script
                  {
                     mvn.build()
                  }
            }
        }
        stage ('generate report')
           {
            steps
             {
                script
                   {
                      mvn.sonar()
                   }
             }
           }
        stage ('move to nexus')
        {
            steps
            {
               script
                    {
                        mvn.deploy()
                     }
            }
        }
        stage ('deploy to tomcat')
        {
            steps
            {
                sh '''  curl -u naveen:Charish@9101112 \
            --upload-file /var/lib/jenkins/workspace/java-scripted-way-job/target/maven-web-application.war \
            "http://13.206.71.179:8080/manager/text/deploy?path=/maven-web-application&update=true" '''
            }
        }
    }
    post{
       success{
            script{
                    SlackNotifications(currentBuild.result)
                   }
               }
        failure{
              script{
                    SlackNotifications(currentBuild.result)
                     }
                 }
           }
}
